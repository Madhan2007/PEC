# ==========================================
# PEC Healthcare Platform - Environment Config
# ==========================================

# Core Django Settings
DEBUG=True
SECRET_KEY=pec-hackathon-unified-healthcare-platform-secret-key-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to SQLite if PostgreSQL is not reachable)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=insurance_db
DB_USER=postgres
DB_PASSWORD=Priyan@12345
DB_HOST=localhost
DB_PORT=5432

# Set to True to force SQLite database
USE_SQLITE=False

# OCR Configuration
OCR_ENGINE=auto
OCR_CONFIDENCE_THRESHOLD=0.75

# AI & Fraud Detection Settings
FRAUD_RISK_HIGH_THRESHOLD=60.0
FRAUD_RISK_MEDIUM_THRESHOLD=30.0
AI_MODEL_ANOMALY_DETECTION=True

# External API & Ingestion Keys (Optional)
EXTERNAL_API_SECRET_KEY=pec-hackathon-external-api-key-2026
