        "jsCode": "// Personalize the message template with contact's name and append opt-out line\nconst template = $('Webhook - Trigger from Frontend').first().json.message || 'Hello {{name}}!';\nconst name = $json.name || 'there';\nlet personalized = template.replace(/{{\\s*name\\s*}}/gi, name);\n\nif (!/stop|unsubscribe/i.test(personalized)) {\n  personalized += ' Reply STOP to unsubscribe.';\n}\n\nreturn [{\n  json: {\n    ...$json,\n    personalizedMessage: personalized\n  }\n}];"
