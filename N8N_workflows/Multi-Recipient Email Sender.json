    {
      "parameters": {
        "jsCode": "const results = $input.all();\n\nconst sent = [];\nconst failed = [];\n\nfor (const item of results) {\n  if (item.json.recipient) {\n    sent.push(item.json.recipient);\n  }\n}\n\nreturn [{\n  json: {\n    status: 'success',\n    sent_count: sent.length,\n    sent_to: sent,\n    failed_count: failed.length,\n    failed_to: failed,\n    message: `Email sent successfully to ${sent.length} recipient(s).`\n  }\n}];"
      },
      "id": "7d195156-dcbd-40da-b8c8-fc10ac9d29c5",
      "name": "Build Success Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -256,
        456
      ]
    },
    {
      "parameters": {
        "jsCode": "const error = $input.first().json;\n\nreturn [{\n  json: {\n    status: 'failed',\n    sent_count: 0,\n    sent_to: [],\n    failed_count: 1,\n    message: error.message || 'Unknown error occurred while sending email.'\n  }\n}];"
      },
