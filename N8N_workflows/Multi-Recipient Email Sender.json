    {
      "parameters": {
        "jsCode": "// Personalize the message template with contact's name\nconst name = $json.name || 'there';\nconst rawContent = $json.message || '';\n\n// Convert markdown-style formatting to WhatsApp formatting\n// WhatsApp: *bold* (single asterisk), _italic_ (underscore)\nlet formattedContent = rawContent\n  .replace(/\\*\\*(.*?)\\*\\*/g, '*$1*')   // **bold** -> *bold*\n  .replace(/\\\\n/g, '\\n');               // literal \\n -> real newline\n\n// Build the final message: greeting + AI-generated content\nconst personalized = `Hello ${name}! 👋\\n\\n${formattedContent}`;\n\nreturn [{\n  json: {\n    ...$json,\n    personalizedMessage: personalized\n  }\n}];"
      },
