    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\n\nconst sender = body.sender || '';\nconst message = body.message || '';\nconst subject = body.subject || 'Message from ' + sender;\nlet recipients = body.recipients;\n\nif (!sender) throw new Error('Missing field: sender');\nif (!message) throw new Error('Missing field: message');\nif (!recipients) throw new Error('Missing field: recipients');\n\nif (typeof recipients === 'string') {\n  recipients = recipients.split(',').map(r => r.trim()).filter(Boolean);\n}\n\nif (!Array.isArray(recipients) || recipients.length === 0) {\n  throw new Error('recipients must be a non-empty array or comma-separated string');\n}\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst invalid = recipients.filter(r => !emailRegex.test(r));\nif (invalid.length > 0) {\n  throw new Error('Invalid email addresses: ' + invalid.join(', '));\n}\n\nreturn recipients.map(email => ({\n  json: { sender, subject, message, recipient: email }\n}));"
      },
      "id": "bbd8101a-22b0-41ec-9150-d3d9cf101225",
      "name": "Parse & Split Recipients",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
