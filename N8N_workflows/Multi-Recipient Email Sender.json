{
  "name": "Multi-Recipient Email Sender",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "d3e6ffbb-e407-4236-a14e-e343c9f3a235",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -928,
        120
      ],
      "webhookId": "send-email"
